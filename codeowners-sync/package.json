{
  "name": "@wunderflats/codeowners-sync",
  "private": true,
  "description": "Generates CODEOWNERS from .github/critical-paths.yml and checks that the two stay in sync",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && ncc build ./src/index.ts -o ./dist && echo '{\"type\":\"module\"}' > dist/package.json",
    "test": "node --experimental-strip-types --no-warnings --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@vercel/ncc": "0.38.4",
    "typescript": "5.9.3"
  }
}
